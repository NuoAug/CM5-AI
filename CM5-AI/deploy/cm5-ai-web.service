[Unit]
Description=CM5-AI interaction web, KWS and device audio
After=network.target cm5-ai-vlm.service
Wants=cm5-ai-vlm.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=cm5
Group=cm5
SupplementaryGroups=audio video render
EnvironmentFile=/etc/cm5-ai.env
WorkingDirectory=/opt/cm5-ai/app
ExecStartPre=/opt/cm5-ai/app/.venv/bin/python /opt/cm5-ai/app/precheck.py --allow-busy
ExecStart=/opt/cm5-ai/app/.venv/bin/python /opt/cm5-ai/app/server.py
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/cm5-ai/logs /opt/cm5-ai/data
LimitNOFILE=65536
# 不用 MemoryMax 直接杀服务；内存预算由应用检查并返回 503。
# MemoryMax=3G

[Install]
WantedBy=multi-user.target
