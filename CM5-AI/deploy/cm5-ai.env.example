# CM5-AI 运行配置。复制到 /etc/cm5-ai.env，权限 600。
# 所有值均为示例，必须按真机实测调整；不要直接照搬到其它硬件。

# --- 进程与网络 ---
WEB_HOST=127.0.0.1
WEB_PORT=8090
PYTHONUNBUFFERED=1

# --- 模型路径（模型不随仓库分发，只使用本机发布清单中的制品） ---
VLM_URL=http://127.0.0.1:8091
# CM5 实测：MiniCPM-V 4.7 视觉编码约 118s/帧，不能实时；当前只作质量/兼容基线。
# 是否引入其它 VLM 必须由主控确认来源与许可后再改，不沿用设备上的旧 Qwen 残留。
VLM_MODEL=/opt/cm5-ai/models/vlm/minicpm-v-4.7-1b/MiniCPM-V-4_7-1B-Q4_K_M.gguf
VLM_MMPROJ=/opt/cm5-ai/models/vlm/minicpm-v-4.7-1b/mmproj-model-f16.gguf
PIPER_BIN=/opt/cm5-ai/runtime/piper/piper
PIPER_MODEL=/opt/cm5-ai/models/tts/piper-zh_CN-huayan-medium/zh_CN-huayan-medium.onnx
KWS_MODEL_DIR=/opt/cm5-ai/models/kws/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01
KWS_KEYWORDS=/opt/cm5-ai/app/config/keywords.txt
DATA_DIR=/opt/cm5-ai/data

# --- 主控接口 interaction.v0.1 ---
# 正式取图只走主控 FrameProvider；未配置时行走查询与正式取图明确不可用，纯聊天仍可用。
IMAGE_SOURCE=main_control
MAIN_CONTROL_URL=
MAIN_CONTROL_RPC_PATH=/interaction/rpc
MAIN_CONTROL_EVENTS_PATH=/interaction/events
MAIN_CONTROL_ASSET_ROOT=/opt/cm5-ai/data/main-control
# 只有显式联调测试替身时才设为 1；生产必须为 0。
MAIN_CONTROL_ALLOW_FIXTURE=0
# MAIN_CONTROL_TOKEN=按主控实际鉴权方式填写；不要写进仓库

# VLM_API_KEY 用 openssl rand -hex 16 生成；vlm 与 web 必须一致。
VLM_API_KEY=CHANGE_ME

# --- CM5 资源预算（4GB 整机，必须留系统内存） ---
# 3.6GB 为模型侧 PSS 预算；VLM 线程数按实测调，不做盲目绑核。
MEM_BUDGET_GB=3.6
# 读取大进程的 smaps_rollup 开销明显；状态/健康轮询用 10 秒缓存
MEM_SAMPLE_TTL=10
VLM_THREADS=3
VLM_CTX=1024
VLM_IMAGE_MAX_SIDE=512
ASR_THREADS=1
ASR_IDLE_SECONDS=180
# 流式 Paraformer（int8）；模型缺失或设为 0 时回退整段离线识别。
ASR_STREAM=1
ASR_STREAM_MODEL_DIR=/opt/cm5-ai/models/asr-streaming/sherpa-onnx-streaming-paraformer-bilingual-zh-en
ASR_STREAM_THREADS=1
ASR_STREAM_INT8=1
OCR_INTRA_THREADS=2
OCR_INTER_THREADS=1
KWS_THREADS=1

# --- TTS（第二阶段：常驻 Piper） ---
# 回滚开关：persistent=常驻 worker（默认，低延迟）；subprocess=每次启动 Piper（旧路径）
TTS_BACKEND=persistent
# TTS_SMOOTH=1 只用于 A/B 对照：会把 >=0.28s 的静音压到 0.15s，默认关闭。
TTS_SMOOTH=0
# 0 表示长驻；设为 60~120 可在内存紧张时释放 Piper worker。
TTS_IDLE_SECONDS=0
TTS_TIMEOUT=90

# KWS 阈值需要在真人「小冰小冰」录音上重新标定；默认值仅来自官方测试音频实验。
KWS_SCORE=2.0
KWS_THRESHOLD=0.10
KWS_TRAILING_BLANKS=8
KWS_INT8=0

# --- 设备输入输出 ---
# browser：Windows 调试；device：CM5 真机（ALSA 语音）
VOICE_SOURCE=device
OUTPUT_SINK=alsa
# 独立实机测试才改为 standalone-device-test；此时会启用本机 CSI 相机并明确标记。
# IMAGE_SOURCE 已在主控接口段设为 main_control。
# 先用 arecord -l / aplay -l 查设备号，不要盲填。
ALSA_INPUT=plughw:0,0
ALSA_OUTPUT=plughw:0,0

# --- 安全与日志 ---
FRAME_MAX_AGE=20
ARMED_SECONDS=15
MIN_VOICE_SECONDS=0.6
MIN_VOICE_RMS=0.008
DEBUG_SNAPSHOT=0
