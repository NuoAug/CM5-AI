# Dedicated physical MiniCPM test only. Copy to config/pi-test.env, chmod 600.
# Keep the real key/local state outside Git. Values are starting settings, not measured acceptance.
PYTHONUNBUFFERED=1
PYTHONUTF8=1
WEB_HOST=127.0.0.1
WEB_PORT=8090
VLM_URL=http://127.0.0.1:8091
VLM_API_KEY=REPLACE_WITH_RANDOM_LOCAL_KEY
VLM_MODEL="/home/mylin/CM5-AI-M/models/vlm/MiniCPM-V 4.7 1B/MiniCPM-V-4_7-1B-Q4_K_M.gguf"
VLM_MMPROJ="/home/mylin/CM5-AI-M/models/vlm/MiniCPM-V 4.7 1B/mmproj-model-f16.gguf"
VLM_THREADS=3
VLM_CTX=2048
VLM_IMAGE_MAX_SIDE=512
MEM_BUDGET_GB=3.0
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
ASR_THREADS=1
ASR_IDLE_SECONDS=180
ASR_BACKEND=streaming-paraformer
ASR_STREAMING_THREADS=1
ASR_STREAMING_MODEL_DIR=/home/mylin/CM5-AI-M/models/asr-streaming/sherpa-onnx-streaming-paraformer-bilingual-zh-en
OCR_INTRA_THREADS=1
OCR_INTER_THREADS=1
KWS_MODEL_DIR=/home/mylin/CM5-AI-M/models/kws/sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01
KWS_KEYWORDS=/home/mylin/CM5-AI-M/app/config/keywords.txt
KWS_THREADS=1
KWS_SCORE=2.0
KWS_THRESHOLD=0.10
KWS_TRAILING_BLANKS=8
KWS_INT8=0
PIPER_BIN=/home/mylin/CM5-AI-M/runtime/piper/piper
PIPER_MODEL=/home/mylin/CM5-AI-M/models/tts/piper-zh_CN-huayan-medium/zh_CN-huayan-medium.onnx
TTS_BACKEND=persistent
TTS_SMOOTH=0
TTS_IDLE_SECONDS=0
TTS_TIMEOUT=90
DATA_DIR=/home/mylin/CM5-AI-M/data
IMAGE_SOURCE=standalone-device-test
VOICE_SOURCE=device
OUTPUT_SINK=alsa
ALSA_INPUT=plughw:CARD=Array,DEV=0
ALSA_OUTPUT=plughw:CARD=Array,DEV=0
ALSA_MIXER_CARD=Array
ALSA_MIXER_CONTROL=PCM,0
# Continuous capture remains on; playback-time ASR is guarded until real AEC/reference verification.
AEC_REFERENCE_VERIFIED=0
BARGE_IN_MIN_VOICED_MS=200
FRAME_MAX_AGE=20
ARMED_SECONDS=15
MIN_VOICE_SECONDS=0.6
MIN_VOICE_RMS=0.008
DEBUG_SNAPSHOT=0
